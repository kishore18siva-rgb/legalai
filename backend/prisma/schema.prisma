generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  name                String
  phoneNumber         String?          @unique
  employeeNumber      String?          @unique
  role                String           @default("COMPLIANCE_OFFICER")
  status              String           @default("ACTIVE")
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  auditLogs           AuditLog[]
  manualCorrections   ExtractedField[] @relation("CorrectedBy")
  inspections         Inspection[]
  reports             Report[]
  approvedRuleUpdates RuleUpdate[]     @relation("ApprovedBy")
}

model LegalSource {
  id            String      @id @default(uuid())
  name          String
  version       String
  effectiveDate String?
  sourceUrl     String?
  fileHash      String
  filePath      String
  status        String      @default("ACTIVE")
  ruleCount     Int         @default(0)
  uploadedAt    DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rules         LegalRule[]
}

model LegalRule {
  id                     String       @id @default(uuid())
  ruleCode               String
  ruleNumber             String
  subRule                String?
  clause                 String?
  schedule               String?
  title                  String
  requirementText        String
  applicabilityCondition String
  validationType         String
  parameters             String?
  exceptions             String?
  capabilityClass        String       @default("STRUCTURED_DATA_CHECKABLE")
  sourceSourceId         String?
  sourcePage             Int
  sourceText             String
  effectiveFrom          String       @default("2011-04-01")
  effectiveTo            String?
  version                Int          @default(1)
  status                 String       @default("ACTIVE")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  sourceDocument         LegalSource? @relation(fields: [sourceSourceId], references: [id])
  ruleResults            RuleResult[]
}

model Product {
  id              String       @id @default(uuid())
  name            String
  brand           String?
  category        String
  packageType     String?
  manufacturer    String?
  packer          String?
  importer        String?
  countryOfOrigin String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  inspections     Inspection[]
}

model Inspection {
  id                     String            @id @default(uuid())
  inspectionNumber       String            @unique
  productId              String?
  inspectorId            String
  status                 String            @default("DRAFT")
  overallResult          String            @default("REVIEW")
  complianceScore        Float             @default(0.0)
  scoreConfidence        Float             @default(0.0)
  passedCount            Int               @default(0)
  failedCount            Int               @default(0)
  reviewCount            Int               @default(0)
  naCount                Int               @default(0)
  pdpFace                String            @default("FRONT")
  pdpDeterminationMethod String            @default("AI")
  ruleVersionUsed        String            @default("2011-V1")
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  extractedFields        ExtractedField[]
  inspector              User              @relation(fields: [inspectorId], references: [id])
  product                Product?          @relation(fields: [productId], references: [id])
  images                 InspectionImage[]
  reports                Report[]
  ruleResults            RuleResult[]
}

model InspectionImage {
  id              String           @id @default(uuid())
  inspectionId    String
  imageType       String           @default("FRONT")
  originalPath    String
  processedPath   String?
  qualityStatus   String           @default("GOOD")
  resolution      String?
  fileSize        Int?
  uploadedAt      DateTime         @default(now())
  extractedFields ExtractedField[]
  inspection      Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  ocrResults      OcrResult[]
  ruleResults     RuleResult[]
}

model OcrResult {
  id                String          @id @default(uuid())
  inspectionImageId String
  fullText          String
  confidence        Float
  boundingBoxesJson String
  rawOcrJson        String?
  provider          String          @default("tesseract")
  processedAt       DateTime        @default(now())
  image             InspectionImage @relation(fields: [inspectionImageId], references: [id], onDelete: Cascade)
}

model ExtractedField {
  id                 String           @id @default(uuid())
  inspectionId       String
  fieldKey           String
  fieldLabel         String
  rawValue           String?
  normalizedValue    String?
  originalText       String?
  language           String?          @default("en")
  script             String?          @default("Latin")
  languageConfidence Float?           @default(0.95)
  unit               String?
  confidence         Float            @default(0.0)
  sourceFace         String?
  detectedFace       String?
  placementStatus    String?
  sourceImageId      String?
  sourceRegionJson   String?
  sourceText         String?
  measurementsJson   String?
  extractionMethod   String           @default("AI_ASSISTED")
  reviewRequired     Boolean          @default(false)
  isCorrected        Boolean          @default(false)
  correctedValue     String?
  correctedByUserId  String?
  correctedAt        DateTime?
  correctionReason   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  correctedByUser    User?            @relation("CorrectedBy", fields: [correctedByUserId], references: [id])
  inspection         Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  sourceImage        InspectionImage? @relation(fields: [sourceImageId], references: [id])
}

model RuleResult {
  id                 String           @id @default(uuid())
  inspectionId       String
  ruleId             String
  ruleCode           String
  ruleNumber         String
  result             String
  requirementText    String
  extractedValue     String?
  originalText       String?
  language           String?          @default("en")
  script             String?          @default("Latin")
  languageConfidence Float?           @default(0.95)
  expectedCondition  String?
  reason             String
  confidence         Float            @default(1.0)
  sourceFace         String?
  detectedFace       String?
  placementStatus    String?
  evidenceImageId    String?
  evidenceRegionJson String?
  measurementsJson   String?
  sourcePage         Int?
  ruleVersion        Int              @default(1)
  evaluatedAt        DateTime         @default(now())
  evidenceImage      InspectionImage? @relation(fields: [evidenceImageId], references: [id])
  inspection         Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  rule               LegalRule        @relation(fields: [ruleId], references: [id])
}

model RuleUpdate {
  id               String           @id @default(uuid())
  sourceUrl        String?
  documentHash     String
  detectedAt       DateTime         @default(now())
  documentVersion  String
  effectiveDate    String?
  previousVersion  String?
  newVersion       String
  changeSummary    String
  approvalStatus   String           @default("PENDING")
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  diffs            RuleChangeDiff[]
  approvedByUser   User?            @relation("ApprovedBy", fields: [approvedByUserId], references: [id])
}

model RuleChangeDiff {
  id           String     @id @default(uuid())
  ruleUpdateId String
  ruleCode     String
  changeType   String
  oldRuleText  String?
  newRuleText  String?
  aiSummary    String?
  ruleUpdate   RuleUpdate @relation(fields: [ruleUpdateId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  action       String
  entity       String
  entityId     String?
  oldValueJson String?
  newValueJson String?
  ipAddress    String?
  timestamp    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model Report {
  id                String     @id @default(uuid())
  inspectionId      String
  reportPath        String
  generatedAt       DateTime   @default(now())
  generatedByUserId String
  generatedByUser   User       @relation(fields: [generatedByUserId], references: [id])
  inspection        Inspection @relation(fields: [inspectionId], references: [id])
}
